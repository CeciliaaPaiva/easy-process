# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=user
DB_PASSWORD=pass
DB_NAME=bpmn_platform
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/bpmn_platform

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── IA: Gemini (gratuito) ────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey (gratuito)
GEMINI_API_KEY=your-gemini-api-key

# ─── IA: Ollama (local, gratuito) ─────────────────────────────────────────────
# URL interna do Docker (não mude em desenvolvimento)
OLLAMA_BASE_URL=http://ollama:11434
# Após "make up", execute: make ollama-pull
OLLAMA_MODEL=qwen2.5:14b

# ─── Whisper ──────────────────────────────────────────────────────────────────
# Opções: tiny, base, small, medium, large
WHISPER_MODEL=base

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Ambiente ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
