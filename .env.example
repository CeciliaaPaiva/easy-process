# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=user
DB_PASSWORD=pass
DB_NAME=bpmn_platform
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/bpmn_platform

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── IA: Gemini ───────────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey (tem tier gratuito)
GEMINI_API_KEY=your-gemini-api-key
# Modelo padrão (fallback) se um dos específicos abaixo não for definido.
GEMINI_MODEL=gemini-flash-lite-latest
# Transcrição é tarefa simples (áudio → texto) — o modelo mais barato basta.
GEMINI_MODEL_TRANSCRIPTION=gemini-flash-lite-latest
# Geração e refino do BPMN exigem raciocínio sobre regras semânticas (tipos de
# gateway, tipos de atividade, pools/raias, anotações) — flash-lite mais
# antigo não seguia essas regras de forma confiável. gemini-2.5-flash era o
# equilíbrio custo x precisão recomendado, mas foi descontinuado para novas
# chaves (404 NOT_FOUND) — o próximo tier "flash" completo (hoje por trás do
# alias gemini-flash-latest) subiu bastante de preço (~$1.50/$9.00 por 1M).
# gemini-3.1-flash-lite foi a escolha (custo ~equivalente ao antigo
# 2.5-flash) — ainda é tier "lite", então reavaliar se a precisão semântica
# continuar insuficiente na prática.
GEMINI_MODEL_GENERATION=gemini-3.1-flash-lite
GEMINI_MODEL_REFINEMENT=gemini-3.1-flash-lite

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Janela fixa por IP (registro/login) ou tenant (upload/chat) — ver
# app/core/rate_limit.py. Defaults abaixo, só declare pra sobrescrever.
# RATE_LIMIT_REGISTER_PER_HOUR=5
# RATE_LIMIT_LOGIN_PER_15MIN=10
# RATE_LIMIT_UPLOAD_PER_HOUR=10
# RATE_LIMIT_CHAT_PER_HOUR=30

# ─── Ambiente ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
