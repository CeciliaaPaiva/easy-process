# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=user
DB_PASSWORD=pass
DB_NAME=bpmn_platform
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/bpmn_platform

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── IA: Gemini ───────────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey (tem tier gratuito)
GEMINI_API_KEY=your-gemini-api-key
# Modelo padrão (fallback) se um dos específicos abaixo não for definido.
GEMINI_MODEL=gemini-flash-lite-latest
# Transcrição é tarefa simples (áudio → texto) — o modelo mais barato basta.
GEMINI_MODEL_TRANSCRIPTION=gemini-flash-lite-latest
# Geração e refino do BPMN exigem raciocínio sobre regras semânticas (tipos de
# gateway, tipos de atividade, pools/raias, anotações) — flash-lite não segue
# essas regras de forma confiável. gemini-2.5-flash é o equilíbrio custo x
# precisão recomendado (bem mais barato que os tiers "pro").
GEMINI_MODEL_GENERATION=gemini-2.5-flash
GEMINI_MODEL_REFINEMENT=gemini-2.5-flash

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Ambiente ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
