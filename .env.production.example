# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=easy_process_prod
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=easy_process_prod
DATABASE_URL=postgresql+asyncpg://easy_process_prod:TROQUE_POR_SENHA_FORTE@db:5432/easy_process_prod

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── IA: Gemini ───────────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
# Um modelo por etapa do pipeline — ver CLAUDE.md ("Atualizando a tabela de
# preços do Gemini") antes de trocar qualquer um destes em produção.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_TRANSCRIPTION=gemini-flash-lite-latest
GEMINI_MODEL_GENERATION=gemini-3.1-flash-lite
GEMINI_MODEL_REFINEMENT=gemini-3.1-flash-lite

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Substitua pelo seu domínio real
CORS_ORIGINS=["https://seudominio.com"]

# ─── Ambiente ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# NEXT_PUBLIC_API_URL não é usado: o proxy do frontend pro backend é
# hardcoded em frontend/next.config.mjs (nome do serviço Docker "backend"),
# não depende de env var.
